rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is an Admin safely
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
             get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role in ["Admin", "Master Admin"];
    }

    // Helper: Check if user is Master Admin safely
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
             get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == "Master Admin";
    }

    // Helper: Check if current authenticated user is operating on their own email record
    function isSelf(email) {
      return request.auth != null && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == email.lower();
    }

    // 1. Notifications: Authenticated users can read and mark read; only admins create or delete
    match /notifications/{document=**} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null;
    }

    // 2. Announcements: Read-only for public/agents, write for Admins only
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Knowledge Base & CMS (Read-Only for Public/Agents, Full Write for Admins)
    match /qna/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /qa/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /facilities/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /files/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /blogs/{document=**} { allow read: if true; allow write: if isAdmin(); }

    // 4. System Status, Settings & Security Locks
    match /system/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /settings/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /security_locks/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSelf(email);
    }

    // 5. User Profiles: Prevent self-promotion to Admin/Master Admin or altering restricted pages
    match /users/{email} {
      allow read: if request.auth != null;
      // Only admins can create admin users; self-provisioning is strictly forced to "Agent"
      allow create: if isAdmin() || (
        isSelf(email) && 
        (!('role' in request.resource.data) || request.resource.data.role == "Agent") &&
        (!('restrictedPages' in request.resource.data) || request.resource.data.restrictedPages.size() == 0)
      );
      // Self update cannot modify role or restrictedPages
      allow update: if isAdmin() || (
        isSelf(email) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'restrictedPages']))
      );
      // Master Admins cannot be deleted by standard Admins
      allow delete: if isMasterAdmin() || (isAdmin() && resource.data.role != "Master Admin");
    }

    // 6. Doubts Board: Agents can post & answer doubts, Admins full access
    match /doubts/{document=**} { 
      allow read: if true; 
      allow create, update: if request.auth != null;
      allow delete: if isAdmin() || (request.auth != null && resource.data.authorEmail == request.auth.token.email);
    }

    // 7. Quizzes & Onboarding Courses: Read-only for agents, write for Admins only
    match /quizzes/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /courses/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /onboarding/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /onboardings/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin();
    }

    // 8. Agent Daily Activity Tracking
    match /daily_activity/{docId} {
      allow read, write: if request.auth != null;
    }
    match /activity_logs/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // 9. Missing Content Tracker
    match /missing_searches/{term} {
      allow read: if isAdmin();
      allow create, update: if true; 
      allow delete: if isAdmin();
    }
    
    // 10. Reports & Issue Tickets
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if isAdmin() || (request.auth != null && resource.data.agentEmail == request.auth.token.email);
      allow update, delete: if isAdmin();
    }
    
    // 11. Verification Bookings & Reschedule Logs
    match /bookings/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /rescheduleLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    // 12. Dispensary Appointments & Clinical Cases (Authenticated Staff/Agents Only)
    match /dispensary_appointments/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /cases/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /caller_history/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /appointments/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 13. Sequence Counters for Appointments & Cases
    match /counters/{document=**} {
      allow read, write: if true;
    }
  }
}
