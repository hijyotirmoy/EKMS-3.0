rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Notifications & Broadcast Announcements (Authenticated Users Only)
    match /notifications/{document=**} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /announcements/{document=**} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // 2. Daily Agent Engagement Logs & Audit Trail Logs (Tamper-Resistant: deletions prohibited)
    match /daily_activity/{document=**} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /userActivityLogs/{document=**} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Default fallback: deny access to any unlisted collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
